# Required
API_KEY=replace-with-a-long-random-bearer-token
WORKER_ID=reasoning-worker-1

# Worker HTTP listener (must be reachable by the gateway)
HOST=0.0.0.0
PORT=3000

# Internal OpenCode server. It binds to 127.0.0.1 only.
OPENCODE_PORT=4100
OPENCODE_BIN=opencode
# If omitted, the worker generates a random password at startup.
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=

# Runtime directories
HOME=/data
WORKSPACE=/data/workspace

# Optional display name returned by /api/identity
WORKER_NAME=opencode-remote-reasoning-worker

# Optional default model, in provider/model or provider/model#variant form.
# OPENCODE_MODEL=opencode/big-pickle

# Optional deploy-time OpenCode configuration. This is merged as high-priority
# config, but the worker forces its identity, agent, tools, and permissions.
# It must be a JSON object. The worker rejects keys such as agent, agents,
# default_agent, instructions, mcp, permissions, plugins, policies, skills,
# tools, update, command(s), reference(s), share, and autoshare.
# OPENCODE_EXTRA_CONFIG={"providers":{"mock":{"name":"Mock","package":"@opencode/ai/providers/openai-compatible","settings":{"apiKey":"test","baseURL":"http://127.0.0.1:5099/v1"},"models":{"mock-model":{"name":"Mock Model","type":"chat","limit":{"context":128000,"output":4096},"capabilities":{"tools":true,"input":["text"],"output":["text"]}}}}}}

# Limits
MAX_CONCURRENT_PROMPTS=4
PROMPT_TIMEOUT_MS=180000
REQUEST_TIMEOUT_MS=30000
OPENCODE_START_TIMEOUT_MS=120000
SHUTDOWN_TIMEOUT_MS=15000
BODY_LIMIT=10mb
MAX_CONTEXT_MESSAGES=100
MAX_TOOLS=64

# Optional raw OpenCode event proxy. This is not reasoning streaming.
ENABLE_EVENT_PROXY=false

# Optional comma-separated CORS origins. CORS is disabled when empty.
CORS_ORIGIN=

# debug | info | warn | error | silent
LOG_LEVEL=info
